# OpenAI API Key (wymagane dla analizy AI kart katalogowych)
# Uzyskaj klucz: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vercel Blob Storage (opcjonalne - wymagane na produkcji)
# Uzyskaj token w: Vercel Dashboard > Storage > Create > Blob
BLOB_READ_WRITE_TOKEN=

# Tryb deweloperski
NODE_ENV=development
